# Supabase (Project settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console → API keys
ANTHROPIC_API_KEY=

# Any long random string; Vercel Cron sends it automatically when set in Vercel
CRON_SECRET=

# Optional tuning
FORMULAK_DAILY_LIMIT=12
FORMULAK_MIN_SCORE=7
FORMULAK_SCORE_MODEL=claude-haiku-5-5
FORMULAK_WRITE_MODEL=claude-sonnet-5-5
ADMIN_PASSWORD=
FORMULAK_SITE_URL=https://formulak.news
# Social (leave empty until phase 5). META_PAGE_ID must be Formula K's own Page.
META_TOKEN=
META_PAGE_ID=
